# Local-only demo mode; never use this for production authentication.
DEMO_AUTH_ENABLED=1
LOCAL_JSON_STORE=1

# Microsoft Entra ID (production or local SSO). Register this exact redirect URI.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
FLASK_SECRET_KEY=
# Optional JSON object mapping Entra group object IDs to one configured role.
ENTRA_GROUP_ROLE_MAP={}

# Optional persistent database and public-only answer provider.
DATABASE_URL_POOLED=
GROQ_API_KEY=
