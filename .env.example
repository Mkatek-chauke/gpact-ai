# Local-only demo mode; never use this for production authentication.
DEMO_AUTH_ENABLED=1
LOCAL_JSON_STORE=1

# Microsoft Entra ID (production or local SSO). Register this exact redirect URI.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
FLASK_SECRET_KEY=
# Optional JSON object mapping Entra group object IDs to one configured role.
ENTRA_GROUP_ROLE_MAP={}

# Optional persistent database and public-only answer provider.
DATABASE_URL_POOLED=
GROQ_API_KEY=
GROQ_WEB_SEARCH_ENABLED=1
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_DOMAINS=gov.za,nsfas.org.za

# Resend password-reset emails for local demo accounts.
RESEND_API_KEY=
RESEND_FROM_EMAIL="iGovPath <onboarding@resend.dev>"
PUBLIC_BASE_URL=http://127.0.0.1:5000
